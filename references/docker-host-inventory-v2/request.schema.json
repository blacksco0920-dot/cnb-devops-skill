{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "Docker host inventory request v2",
  "$comment": "Closed no-shell argv contract (absolute executables; Docker uses the request-bound --config and --host prefix): uname -r; docker version; docker ps -aq --no-trunc; docker container inspect -- <sorted-full-container-ids>; docker image inspect -- <sorted-unique-full-sha256-image-ids>; docker volume ls -q; docker volume inspect -- <sorted-safe-volume-names>; docker network ls -q --no-trunc; docker network inspect -- <sorted-full-network-ids>; docker container diff -- <full-container-id>; optional host probes tar --version; zstd --version; psql --version; pg_dump --version; redis-server --version; caddy version; visudo -V.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_nonce",
    "request_policy_sha256",
    "source_lock_sha256",
    "collector_sha256",
    "docker_command",
    "docker_config_path",
    "docker_socket_path",
    "observed_sources",
    "trusted_ancestor_paths",
    "caddy_roots",
    "allowed_registry_dns_prefixes",
    "expected_name_sha256",
    "expected_path_sha256",
    "approved_repo_digest_sha256",
    "service_role_sha256",
    "max_containers",
    "max_volumes",
    "max_networks",
    "max_mounts_per_container",
    "max_ports_per_container",
    "max_command_output_bytes",
    "max_command_seconds",
    "max_command_calls",
    "max_total_command_output_bytes",
    "max_total_command_seconds",
    "max_topology_bytes",
    "max_observation_bytes",
    "max_inventory_bytes",
    "max_recursive_entries",
    "max_acl_entries",
    "max_acl_bytes_per_path",
    "max_path_bytes",
    "max_persistence_file_bytes",
    "request_identity_projection_sha256",
    "inventory_target_claim_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deploydesk-docker-host-inventory-request/v2"},
    "inventory_nonce": {"$ref": "#/$defs/sha256"},
    "request_policy_sha256": {"$ref": "#/$defs/sha256"},
    "source_lock_sha256": {"$ref": "#/$defs/sha256"},
    "collector_sha256": {"$ref": "#/$defs/sha256"},
    "docker_command": {"const": ["/usr/bin/docker"]},
    "docker_config_path": {"const": "/etc/docker"},
    "docker_socket_path": {"enum": ["/var/run/docker.sock", "/run/docker.sock"]},
    "observed_sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/opt_source"},
        {"$ref": "#/$defs/postgresql_source"},
        {"$ref": "#/$defs/redis_source"}
      ],
      "items": false
    },
    "trusted_ancestor_paths": {"$ref": "#/$defs/path_array"},
    "caddy_roots": {"$ref": "#/$defs/path_array"},
    "allowed_registry_dns_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"}
    },
    "expected_name_sha256": {"$ref": "#/$defs/digest_array"},
    "expected_path_sha256": {"$ref": "#/$defs/digest_array"},
    "approved_repo_digest_sha256": {"$ref": "#/$defs/digest_array"},
    "service_role_sha256": {"$ref": "#/$defs/service_roles"},
    "max_containers": {"type": "integer", "minimum": 1, "maximum": 70},
    "max_volumes": {"type": "integer", "minimum": 1, "maximum": 4096},
    "max_networks": {"type": "integer", "minimum": 1, "maximum": 4096},
    "max_mounts_per_container": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_ports_per_container": {"type": "integer", "minimum": 1, "maximum": 1024},
    "max_command_output_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "max_command_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "max_command_calls": {"type": "integer", "minimum": 1, "maximum": 1024},
    "max_total_command_output_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "max_total_command_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
    "max_topology_bytes": {"type": "integer", "minimum": 1, "maximum": 1572864},
    "max_observation_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "max_inventory_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "max_recursive_entries": {"type": "integer", "minimum": 1, "maximum": 250000},
    "max_acl_entries": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_acl_bytes_per_path": {"type": "integer", "minimum": 1, "maximum": 65536},
    "max_path_bytes": {"type": "integer", "minimum": 1, "maximum": 4096},
    "max_persistence_file_bytes": {"type": "integer", "minimum": 1, "maximum": 8.589934592e9},
    "request_identity_projection_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_target_claim_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/(?:(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*)?$"},
    "path_array": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "digest_array": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "service_role_array": {"type": "array", "minItems": 1, "maxItems": 70, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "service_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caddy", "redis"],
      "properties": {"caddy": {"$ref": "#/$defs/service_role_array"}, "redis": {"$ref": "#/$defs/service_role_array"}}
    },
    "opt_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {"role": {"const": "opt"}, "path": {"$ref": "#/$defs/path"}}
    },
    "postgresql_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {"role": {"const": "postgresql"}, "path": {"$ref": "#/$defs/path"}}
    },
    "redis_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {"role": {"const": "redis"}, "path": {"$ref": "#/$defs/path"}}
    }
  }
}
