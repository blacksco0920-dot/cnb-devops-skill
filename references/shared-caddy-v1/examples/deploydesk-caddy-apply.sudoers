# Generated and reviewed for one explicitly provisioned deployment; validate with visudo.
# The caller retains /var/lib/deploydesk/locks/releases/sample-app--test.release.lock.
Cmnd_Alias SAMPLE_APP_CADDY_PREFLIGHT = /usr/local/sbin/deploydesk-caddy-apply ^--preflight --deployment-id sample-app--test --bundle-id [0-9a-f]{64}$
Cmnd_Alias SAMPLE_APP_CADDY_APPLY = /usr/local/sbin/deploydesk-caddy-apply ^--deployment-id sample-app--test --bundle-id [0-9a-f]{64}$
ubuntu ALL=(root) NOPASSWD: SAMPLE_APP_CADDY_PREFLIGHT, SAMPLE_APP_CADDY_APPLY
