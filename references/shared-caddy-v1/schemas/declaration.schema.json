{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/shared-caddy/v1/declaration.schema.json",
  "title": "Shared Caddy v1 project declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "environment", "deployment_id", "source_repo", "compose_path", "routes"],
  "properties": {
    "contract_version": {"const": "shared-caddy-contract/v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "environment": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"},
    "deployment_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?--[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"},
    "source_repo": {"type": "string", "pattern": "^https://(?=[^/]{1,253}/)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?:/[A-Za-z0-9._~-]+)+$"},
    "compose_path": {"const": "runtime/compose.json"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "host", "service", "upstream", "port", "network"],
            "properties": {
              "type": {"const": "docker_proxy"},
              "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
              "service": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"},
              "upstream": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "network": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "host", "target_host"],
            "properties": {
              "type": {"const": "https_proxy"},
              "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
              "target_host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "host", "target_host", "preserve_uri", "redirect_code"],
            "properties": {
              "type": {"const": "redirect"},
              "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
              "target_host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
              "preserve_uri": {"const": true},
              "redirect_code": {"enum": [301, 308]}
            }
          }
        ]
      }
    }
  }
}
