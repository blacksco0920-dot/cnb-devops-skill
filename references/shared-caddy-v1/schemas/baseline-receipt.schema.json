{
  "$id": "https://schemas.example.invalid/shared-caddy/v1/baseline-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "baseline_provenance_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "compose_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract_version": {"const": "shared-caddy-contract/v1"},
    "declaration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "deployment_id": {"const": "sample-app--legacy-edge"},
    "environment": {"const": "legacy-edge"},
    "fragment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "generation_id": {"pattern": "^gen-[0-9a-f]{32}$", "type": "string"},
    "git_sha": {"pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "type": "string"},
    "helper_requirement_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "helper_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "helper_version": {"const": "1.0.0"},
    "hosts": {"maxItems": 3, "minItems": 3, "prefixItems": [{"const": "app.sample.example.invalid"}, {"const": "admin.sample.example.invalid"}, {"const": "api.sample.example.invalid"}], "type": "array", "uniqueItems": true},
    "old_generation": {"pattern": "^gen-[0-9a-f]{32}$", "type": "string"},
    "project_id": {"const": "sample-app"},
    "schema_version": {"const": "shared-caddy-baseline-receipt/v1"},
    "server_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source_repo": {"const": "https://example.invalid/sample-org/sample-app"},
    "status": {"const": "committed"},
    "transaction_id": {"pattern": "^tx-[0-9a-f]{32}$", "type": "string"}
  },
  "required": ["schema_version", "status", "contract_version", "helper_version", "helper_sha256", "transaction_id", "project_id", "environment", "deployment_id", "source_repo", "archive_id", "git_sha", "declaration_sha256", "fragment_sha256", "compose_sha256", "helper_requirement_sha256", "baseline_provenance_sha256", "server_manifest_sha256", "old_generation", "generation_id", "hosts"],
  "title": "Shared Caddy v1 committed legacy baseline receipt",
  "type": "object"
}
