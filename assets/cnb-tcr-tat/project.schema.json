{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/cnb-devops/project-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "environment": {
      "const": "test"
    },
    "cnb_repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)+$"
    },
    "test_branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_/-]*$"
    },
    "production_branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_/-]*$"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dockerfile": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "image_repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^ccr\\.ccs\\.tencentyun\\.com/[a-z0-9-]+/[a-z0-9][a-z0-9._/-]*$"
          },
          "runtime_env": {
            "type": "boolean"
          },
          "environment": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "environment_refs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "healthcheck": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "test": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "interval": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9]+s$"
              },
              "timeout": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9]+s$"
              },
              "retries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "start_period": {
                "type": "string",
                "maxLength": 8,
                "pattern": "^[1-9][0-9]*(?:s|m)$"
              }
            },
            "required": [
              "test"
            ]
          },
          "expose": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "mounts": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
                },
                "target": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
                }
              },
              "required": [
                "source",
                "target"
              ]
            }
          },
          "loopback_port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "resource_limits": {
            "$ref": "#/$defs/resource_limits"
          }
        },
        "required": [
          "dockerfile",
          "context",
          "image_repository"
        ],
        "dependentSchemas": {
          "loopback_port": {
            "required": [
              "expose"
            ],
            "properties": {
              "expose": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9./_-]+(?::[a-zA-Z0-9._-]+)?@sha256:[a-f0-9]{64}$"
        },
        "npm_registry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[a-zA-Z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9_./?=&%-]*$"
        }
      },
      "required": [
        "verify",
        "image",
        "npm_registry"
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tcr_import": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://cnb\\.cool/[a-zA-Z0-9_/-]+/-/blob/[a-zA-Z0-9_/-]+\\.ya?ml$"
        },
        "tat_import": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://cnb\\.cool/[a-zA-Z0-9_/-]+/-/blob/[a-zA-Z0-9_/-]+\\.ya?ml$"
        }
      },
      "required": [
        "tcr_import",
        "tat_import"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_caddy_gateway": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "release_user": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_][a-z0-9_-]*$",
          "not": {
            "const": "root"
          }
        },
        "networks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url_env": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.-]+$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "container": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.-]+$"
            },
            "admin_user": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "url_env",
            "host",
            "port",
            "name",
            "user",
            "container",
            "admin_user"
          ]
        },
        "migration": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "service",
                "argv"
              ]
            }
          ]
        },
        "availability_probes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[a-zA-Z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9_./?=&%-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "identity_probes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://[a-zA-Z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9_./?=&%-]*$"
              },
              "service": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "api_envelope": {
                "type": "boolean",
                "description": "false expects the raw cnb-release-identity/v1 object. true expects exactly code=0, message=ok and data.release containing that identity; it does not accept arbitrary API response wrappers."
              }
            },
            "required": [
              "url",
              "service",
              "api_envelope"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "proxy_container": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "host": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "container": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            },
            "prefix_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "prefix": {
              "type": "string",
              "pattern": "^[a-z0-9:_-]{1,128}$"
            }
          },
          "required": [
            "url_env",
            "host",
            "port",
            "database",
            "container"
          ],
          "dependentRequired": {
            "prefix_env": [
              "prefix"
            ],
            "prefix": [
              "prefix_env"
            ]
          }
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200,
          "default": 300
        }
      },
      "required": [
        "database",
        "required_env",
        "migration",
        "availability_probes",
        "identity_probes"
      ]
    },
    "github_sync": {
      "type": "boolean"
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/properties/host"
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "environment": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "environment_refs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              },
              "loopback_port": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            }
          }
        },
        "tat_import": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://cnb\\.cool/[a-zA-Z0-9_/-]+/-/blob/[a-zA-Z0-9_/-]+\\.ya?ml$"
        },
        "approval_public_key": {
          "type": "string",
          "minLength": 110,
          "maxLength": 120,
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/]{59}=\\n-----END PUBLIC KEY-----\\n$"
        }
      },
      "required": [
        "host",
        "tat_import",
        "approval_public_key"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mounts": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "additionalProperties": {
            "enum": [
              "backup",
              "rebuild"
            ]
          }
        },
        "required_nonempty_tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$"
              },
              "minimum_rows": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "schema",
              "name",
              "minimum_rows"
            ]
          }
        }
      },
      "required": [
        "mounts",
        "required_nonempty_tables"
      ]
    }
  },
  "$defs": {
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {"type": "integer", "minimum": 33554432, "maximum": 6.8719476736e10, "description": "Memory limit in bytes, from 32 MiB through 64 GiB."},
        "cpu_millis": {"type": "integer", "minimum": 50, "maximum": 64000}
      },
      "required": ["memory_bytes", "cpu_millis"]
    }
  },
  "required": [
    "schema_version",
    "project",
    "environment",
    "cnb_repository",
    "test_branch",
    "production_branch",
    "services",
    "ci",
    "secrets",
    "host"
  ]
}
